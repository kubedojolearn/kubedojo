# KubeDojo environment variables.
#
# `make setup` copies this file to .env and fills every value marked GENERATED with fresh
# random development secrets. Never commit .env. Production values live in the deployment
# platform's secret store and must be different from development ones.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production. Production enables strict checks (e.g. TLS to Redis).
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL (system of record). Docker Compose creates the database from these.
# ---------------------------------------------------------------------------
POSTGRES_USER=kubedojo
POSTGRES_PASSWORD=GENERATED
POSTGRES_DB=kubedojo
# Host port for Compose's Postgres (change if 5432 is taken).
POSTGRES_PORT=5432
# Used by the API/worker when running on the host (`make dev`). Compose sets its own for containers.
DATABASE_URL=postgres://kubedojo:GENERATED@localhost:5432/kubedojo?sslmode=disable
# Isolated database for integration tests (created by infra/compose/postgres/10-create-test-db.sh).
TEST_DATABASE_URL=postgres://kubedojo:GENERATED@localhost:5432/kubedojo_test?sslmode=disable

# ---------------------------------------------------------------------------
# Redis (disposable coordination: WS tickets, rate limits, pub/sub). Use rediss:// in production.
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Separate logical database for tests; tests flush it.
TEST_REDIS_URL=redis://localhost:6379/15

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Go API listen address (private network only; see ADR-0003).
API_LISTEN_ADDR=:8080
# How the Next.js BFF reaches the Go API.
API_INTERNAL_URL=http://localhost:8080
# The single public origin (the edge proxy). Used for CSRF/Origin checks and OAuth callbacks.
WEB_ORIGIN=http://localhost:8000
# Comma-separated origins allowed to open lab WebSockets. Normally the same as WEB_ORIGIN.
WS_ALLOWED_ORIGINS=http://localhost:8000
# Host port of the edge proxy.
EDGE_PORT=8000
# Graceful shutdown budget for the API and worker.
SHUTDOWN_TIMEOUT=15s
# Per-request deadline for the API (1s-1m).
REQUEST_TIMEOUT=5s
# Maximum API request body in bytes (lab commands are <=16 KiB, manifests <=64 KiB).
MAX_BODY_BYTES=131072
# Comma-separated CIDRs of proxies allowed to set X-Forwarded-For (the edge). Empty = trust none.
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# Authentication (used from Part 06)
# ---------------------------------------------------------------------------
# Auth.js session encryption secret: 32+ random bytes, base64.
AUTH_SECRET=GENERATED
# GitHub OAuth app credentials. Create an OAuth app at https://github.com/settings/developers with
# callback URL ${WEB_ORIGIN}/api/auth/callback/github. Leave empty until you need to sign in locally.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 1 enables a "test sign-in" form for automated tests (no GitHub needed). Never in production:
# the web app refuses to start with AUTH_TEST_MODE=1 and APP_ENV=production.
AUTH_TEST_MODE=0

# ---------------------------------------------------------------------------
# Internal assertions: Next.js BFF -> Go API (ADR-0003)
# ---------------------------------------------------------------------------
# Ed25519 private key, base64 of PKCS#8 DER. Server-side only; never NEXT_PUBLIC_*.
# Generate a new pair with: node scripts/gen-env.mjs --print-keypair <kid>
BFF_SIGNING_PRIVATE_KEY=GENERATED
# Key ID put in the JWT header; must appear in API_JWT_PUBLIC_KEYS.
BFF_SIGNING_KID=dev-1
# Comma-separated kid:base64(SPKI DER) public keys the API accepts. During rotation, list both keys.
API_JWT_PUBLIC_KEYS=GENERATED

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# OTLP/HTTP endpoint for traces and metrics, e.g. http://localhost:4318. Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=
