# Edge reverse proxy: the single public origin (ADR-0003).
#   /api/v1/ws/*   -> Go realtime endpoint (the only Go route reachable from outside)
#   /api/v1/*      -> 404 (Go REST is private; only the Next.js BFF calls it)
#   everything else -> Next.js
{
	admin off
	auto_https off
}

:8000 {
	encode zstd gzip

	@ws path /api/v1/ws/*
	handle @ws {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	@api_rest path /api/v1/*
	handle @api_rest {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}
