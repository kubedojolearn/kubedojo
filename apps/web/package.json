    "@lezer/highlight": "1.2.5",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "jose": "6.2.15",
    "lucide-react": "1.68.0",
