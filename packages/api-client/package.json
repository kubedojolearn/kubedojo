{
  "name": "@kubedojo/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the KubeDojo Go API, generated from docs/api/openapi.yaml",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.yaml -o src/schema.d.ts && prettier --write src/schema.d.ts --log-level warn",
    "check:generated": "pnpm generate && git diff --exit-code -- src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
