{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubedojo.dev/schemas/content/glossary.schema.json",
  "title": "KubeDojo glossary",
  "description": "content/glossary.yaml: short definitions linked from lessons.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "terms"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "term", "definition"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "definition": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "docsUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
