{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubedojo.dev/schemas/content/fixture.schema.json",
  "title": "KubeDojo simulated cluster fixture",
  "description": "content/fixtures/*.yaml: the initial state of a lab. The simulator validates object shapes in depth when loading (Part 09); this schema checks structure and the supported-kind boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "simulatorVersion", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "simulatorVersion": { "$ref": "common.schema.json#/$defs/simulatorVersion" },
    "description": { "type": "string", "maxLength": 500 },
    "epoch": {
      "description": "Simulated clock start. Default 2026-01-01T00:00:00Z.",
      "type": "string",
      "format": "date-time"
    },
    "kubeconfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": { "$ref": "common.schema.json#/$defs/dnsLabel" }
      }
    },
    "imageCatalog": {
      "description": "Images added to the built-in catalog for this fixture.",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/catalogImage" }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "catalogImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "behavior"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$",
          "maxLength": 255
        },
        "behavior": { "enum": ["run", "crash"] },
        "exitCode": { "type": "integer", "minimum": 1, "maximum": 255 },
        "requiresEnv": {
          "description": "crash only: the container crashes only when one of these env vars is missing.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "logs": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "maxLength": 500 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "behavior": { "const": "crash" } } },
          "then": { "required": ["exitCode"] },
          "else": { "not": { "anyOf": [{ "required": ["exitCode"] }, { "required": ["requiresEnv"] }] } }
        }
      ]
    },
    "resource": {
      "type": "object",
      "required": ["apiVersion", "kind", "metadata"],
      "properties": {
        "apiVersion": { "type": "string" },
        "kind": {
          "description": "EndpointSlice, Endpoints and ReplicaSet/Pod objects owned by controllers are generated by reconciliation and should not be in fixtures.",
          "enum": ["Namespace", "Node", "Pod", "Deployment", "ReplicaSet", "Service", "ConfigMap", "Secret"]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "$ref": "common.schema.json#/$defs/dnsSubdomain" },
            "namespace": { "$ref": "common.schema.json#/$defs/dnsLabel" },
            "labels": { "$ref": "common.schema.json#/$defs/labelMap" },
            "annotations": { "$ref": "common.schema.json#/$defs/annotationMap" }
          }
        },
        "ageSeconds": {
          "description": "Backdates creationTimestamp relative to the fixture epoch. Stripped on load.",
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "spec": { "type": "object" },
        "status": {
          "description": "Only allowed on Node (capacity, allocatable, conditions). Everything else gets status from reconciliation.",
          "type": "object"
        },
        "data": { "type": "object", "additionalProperties": { "type": "string" } },
        "stringData": { "type": "object", "additionalProperties": { "type": "string" } },
        "type": { "const": "Opaque" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "Namespace" } } },
          "then": {
            "properties": { "apiVersion": { "const": "v1" }, "metadata": { "not": { "required": ["namespace"] } } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Node" } } },
          "then": {
            "required": ["status"],
            "properties": { "apiVersion": { "const": "v1" }, "metadata": { "not": { "required": ["namespace"] } } }
          },
          "else": { "not": { "required": ["status"] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["Pod", "Service", "ConfigMap", "Secret"] } } },
          "then": { "properties": { "apiVersion": { "const": "v1" } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["Deployment", "ReplicaSet"] } } },
          "then": { "required": ["spec"], "properties": { "apiVersion": { "const": "apps/v1" } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["ConfigMap", "Secret"] } } },
          "then": { "not": { "required": ["spec"] } },
          "else": { "not": { "anyOf": [{ "required": ["data"] }, { "required": ["stringData"] }] } }
        },
        {
          "if": { "properties": { "kind": { "const": "Secret" } } },
          "else": { "not": { "anyOf": [{ "required": ["type"] }, { "required": ["stringData"] }] } }
        }
      ]
    }
  }
}
