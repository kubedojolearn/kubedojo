{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubedojo.dev/schemas/content/course.schema.json",
  "title": "KubeDojo course",
  "description": "content/courses/<slug>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "title", "summary", "description", "difficulty", "displayOrder", "lessons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 200 },
    "description": { "$ref": "common.schema.json#/$defs/markdown" },
    "difficulty": { "$ref": "common.schema.json#/$defs/difficulty" },
    "displayOrder": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "prerequisites": {
      "description": "Course slugs the learner should finish first (advisory).",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    },
    "lessons": {
      "description": "Lesson slugs in display order. Each must have content/challenges/<course>/<lesson>.yaml.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    }
  }
}
