# KubeDojo self-host settings, read by compose.yaml in this folder.
#
# Create .env from this file with fresh secrets (fills every GENERATED value; needs only Docker):
#   docker run --rm -v "$PWD:/w" -w /w -u "$(id -u):$(id -g)" node:24-alpine node gen-env.mjs
# Never commit or share .env.

# Image tag: latest (the newest weekly release) or a release date such as 2026-11-09 to pin one.
KUBEDOJO_TAG=latest

# The URL people open, without a trailing slash. Must match what's in the browser's address bar,
# e.g. https://kubedojo.example.com once HTTPS is in front of the stack.
WEB_ORIGIN=http://localhost:8000
# Where the stack listens. 127.0.0.1 keeps it local to this machine (put an HTTPS proxy or tunnel
# in front of it); 0.0.0.0 exposes plain HTTP to your network.
EDGE_BIND=127.0.0.1
EDGE_PORT=8000

# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL. The database lives in the pgdata Docker volume.
POSTGRES_USER=kubedojo
POSTGRES_PASSWORD=GENERATED
POSTGRES_DB=kubedojo

# Auth.js session encryption secret.
AUTH_SECRET=GENERATED

# Signing keys between the web app and the API (ADR-0003). Generated as a matching pair.
BFF_SIGNING_KID=selfhost-1
BFF_SIGNING_PRIVATE_KEY=GENERATED
API_JWT_PUBLIC_KEYS=GENERATED

# Sign-in through Asgardeo (optional). Without these, KubeDojo runs but nobody can sign in.
# Setup: docs/operations/auth.md; the redirect URL is ${WEB_ORIGIN}/api/auth/callback/asgardeo.
AUTH_ASGARDEO_ID=
AUTH_ASGARDEO_SECRET=
AUTH_ASGARDEO_ISSUER=
AUTH_ASGARDEO_GOOGLE_CONNECTION=Google
AUTH_ASGARDEO_GITHUB_CONNECTION=GitHub
